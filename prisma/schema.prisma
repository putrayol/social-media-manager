// Prisma schema for Social Media Manager
// Database provider is configurable via DATABASE_URL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Aktivator {
  id             Int      @id @default(autoincrement())
  no             Int
  namaAkun       String
  platform       String   // TIKTOK, INSTAGRAM, FACEBOOK, TWITTER, YOUTUBE, OTHER
  link           String?  // Profile URL
  organizationId String?  // Clerk organization ID
  reportId       String?
  report         SocialMediaReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cyberTroops    CyberTroops[]  // Related cyber troops
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model CyberTroops {
  id             Int      @id @default(autoincrement())
  no             Int
  aktivatorId    Int?     // Relation to Aktivator
  aktivator      Aktivator? @relation(fields: [aktivatorId], references: [id], onDelete: SetNull)
  namaAkun       String   // Derived from aktivator or manually set
  platform       String   // TIKTOK, INSTAGRAM, FACEBOOK, TWITTER, YOUTUBE, OTHER
  kategori       String   // e.g., "Positif" | "Negatif"
  jenisIsu       String
  jumlahKomentar Int
  jumlahLike     Int      @default(0)
  link           String?  // Posting URL
  keterangan     String?
  organizationId String?  // Clerk organization ID
  reportId       String?
  report         SocialMediaReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  requestId      Int?
  request        Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([aktivatorId])
}

model TopKomentar {
  id                   Int      @id @default(autoincrement())
  no                   Int
  namaAkun             String
  platform             String   // TIKTOK, INSTAGRAM, FACEBOOK, TWITTER, YOUTUBE, OTHER
  jumlahTopKomentar    Int
  jumlahLike           Int      @default(0)
  linkProfile          String?  // Profile URL
  link                 String?  // Posting URL
  keterangan           String?
  documentFilesData    String?  // JSON string for document files
  organizationId       String?  // Clerk organization ID
  reportId             String?
  report               SocialMediaReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  requestId            Int?
  request              Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId])
}

model Request {
  id              Int      @id @default(autoincrement())
  no              Int
  tanggalMulai    DateTime?
  tanggalBerakhir DateTime?
  namaPaket       String
  tiktokPost      Int      @default(0)
  tiktokKomen     Int      @default(0)
  tiktokLike      Int      @default(0)
  instagramPost   Int      @default(0)
  instagramKomen  Int      @default(0)
  instagramLike   Int      @default(0)
  facebookPost    Int      @default(0)
  facebookKomen   Int      @default(0)
  facebookLike    Int      @default(0)
  twitterPost     Int      @default(0)
  twitterKomen    Int      @default(0)
  twitterLike     Int      @default(0)
  youtubePost     Int      @default(0)
  youtubeKomen    Int      @default(0)
  youtubeLike     Int      @default(0)
  otherPost       Int      @default(0)
  otherKomen      Int      @default(0)
  otherLike       Int      @default(0)
  bonus           String?
  organizationId  String?  // Clerk organization ID
  cyberTroops     CyberTroops[]
  topKomentar     TopKomentar[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model SocialMediaReport {
  id             String   @id @default(cuid())
  reportNo       String   @unique
  namaLaporan    String?  // Report name
  tanggal        DateTime
  organizationId String?  // Clerk organization ID
  aktivator      Aktivator[]
  cyberTroops    CyberTroops[]
  topKomentar    TopKomentar[]
  lapsusData     String?  // JSON string for lapsus data
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model LaporanKhusus {
  id                String   @id @default(cuid())
  reportId          String   @unique
  tanggal           DateTime
  jumlahKomentar    Int
  jumlahPostingan   Int
  keterangan        String?
  documentFilesData String?  // JSON string for document files
  organizationId    String?  // Clerk organization ID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
}